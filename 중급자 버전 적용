import streamlit as st
from openai import OpenAI

# === 페이지 설정 ===
st.set_page_config(page_title="GPT 코딩 도우미", layout="centered")

# === 세션 상태 초기화 ===
if "api_key" not in st.session_state:
    st.session_state.api_key = ""
if "messages" not in st.session_state:
    st.session_state.messages = [{"role": "system", "content": "당신은 친절한 코딩 도우미입니다."}]
if "chat_input" not in st.session_state:
    st.session_state.chat_input = ""
if "user_level" not in st.session_state:
    st.session_state.user_level = "초급자"

# === API Key 입력 ===
st.sidebar.title("🔐 OpenAI API 설정")
st.session_state.api_key = st.sidebar.text_input("API Key를 입력하세요:", type="password", value=st.session_state.api_key)

if not st.session_state.api_key:
    st.sidebar.warning("⚠️ API Key를 입력해야 챗봇이 작동합니다.")

# === 사용자 레벨 설정 ===
st.sidebar.title("🧠 사용자 수준 설정")
col1, col2 = st.sidebar.columns(2)
with col1:
    if st.button("👶 초급자 모드"):
        st.session_state.user_level = "초급자"
with col2:
    if st.button("🧠 중급자 모드"):
        st.session_state.user_level = "중급자"

st.sidebar.markdown(f"현재 모드: **{st.session_state.user_level}**")

# === 모델 선택 ===
model = st.sidebar.selectbox("사용할 모델을 선택하세요:", ["gpt-3.5-turbo", "gpt-4.1-mini"], index=1)

# === 대화 초기화 버튼 ===
if st.sidebar.button("🧹 대화 초기화"):
    st.session_state.messages = [{"role": "system", "content": "당신은 친절한 코딩 도우미입니다."}]
    st.session_state.chat_input = ""
    st.success("✅ 대화가 초기화되었습니다.")

# === 제목 ===
st.title("👨‍💻 GPT 코딩 도우미 챗봇")

# === 이전 대화 출력 ===
for msg in st.session_state.messages[1:]:
    if msg["role"] == "user":
        st.markdown(f"**🧑 사용자:** {msg['content']}")
    elif msg["role"] == "assistant":
        st.markdown(f"**🤖 GPT:** {msg['content']}")

# === 사용자 입력창 ===
user_input = st.text_input("💬 메시지를 입력하세요:", value=st.session_state.chat_input, key="chat_input_box")

# === 사용자 입력 처리 ===
if user_input and st.session_state.api_key:
    st.session_state.chat_input = user_input

    # 사용자 수준에 따른 system 프롬프트 설정
    if st.session_state.user_level == "초급자":
        system_prompt = "너는 초급자를 위한 친절한 코딩 도우미야. 사용자의 질문에 대한 코드를 먼저 보여주고, 그 코드가 어떤 의미인지 초등학생도 이해할 수 있게 자연어로 자세히 설명해줘."
    else:
        system_prompt = "너는 중급자를 위한 코딩 도우미야. 사용자의 질문에 대해 코드만 출력해줘. 설명은 하지 않아도 돼."

    # 메시지 구성
    messages = [
        {"role": "system", "content": system_prompt},
        {"role": "user", "content": user_input}
    ]

    try:
        client = OpenAI(api_key=st.session_state.api_key)
        response = client.chat.completions.create(
            model=model,
            messages=messages,
            temperature=0.7,
            max_tokens=1000,
        )
        reply = response.choices[0].message.content

        # 대화 저장
        st.session_state.messages.append({"role": "user", "content": user_input})
        st.session_state.messages.append({"role": "assistant", "content": reply})
        st.session_state.chat_input = ""
        st.rerun()

    except Exception as e:
        st.error(f"❌ 오류 발생: {str(e).encode('utf-8', errors='ignore').decode('utf-8')}")

elif not st.session_state.api_key:
    st.warning("⚠️ 먼저 OpenAI API Key를 입력해주세요.")
